# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,id=bulk-video-review-npm,target=/root/.npm,sharing=locked \
    npm ci --ignore-scripts

COPY . .
ARG VCS_REF
RUN BVR_BUILD_REVISION="$VCS_REF" npm run build

FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS runtime

ARG VCS_REF
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    DIST_ROOT=/app/dist

LABEL org.opencontainers.image.source="https://github.com/KyleLeduc/bulk-video-review" \
      org.opencontainers.image.revision="${VCS_REF}"

RUN groupadd --gid 10001 bvr \
    && useradd --uid 10001 --gid bvr --home-dir /app --shell /usr/sbin/nologin bvr \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx

WORKDIR /app
COPY --from=build --chown=10001:10001 /app/dist /app/dist
COPY --from=build --chown=10001:10001 /app/scripts/productionServer.mjs /app/scripts/productionServer.mjs

USER 10001:10001
EXPOSE 3000
CMD ["node", "/app/scripts/productionServer.mjs"]
