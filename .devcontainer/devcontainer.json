{
  "name": "Node.js & TypeScript + Codex CLI",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    5173
  ],
  "shutdownAction": "stopContainer",
  "runArgs": [
    // "--env-file",
    // "${localWorkspaceFolder}/.env",
    "--name",
    "dev-${localWorkspaceFolderBasename}"
  ],
  "containerEnv": {
    "TZ": "America/Denver",
    "DOCKER_HOST": "unix:///run/user/1001/docker.sock"
  },
  "mounts": [
    "source=bulk-video-review-node-modules,target=/workspaces/bulk-video-review/node_modules,type=volume",
    "source=/home/dev1/projects/.config/.codex,target=/root/.codex,type=bind",
    "source=/home/dev1/projects/.config/.gh,target=/root/.config/gh,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind",
    "source=/run/user/1001/docker.sock,target=/run/user/1001/docker.sock,type=bind"
  ],
  "postCreateCommand": "npm install && npm install -g @openai/codex && codex --help",
  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "rvest.vs-code-prettier-eslint",
        "vitest.explorer",
        "yoavbls.pretty-ts-errors",
        "zhuangtongfa.material-theme",
        "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
        "bierner.markdown-mermaid",
        "eamodio.gitlens",
        "github.copilot-chat",
        "github.copilot",
        "ms-azuretools.vscode-docker",
        "emilast.LogFileHighlighter",
        "MermaidChart.vscode-mermaid-chart",
        "openai.chatgpt",
        "systemticks.c4-dsl-extension",
        "antfu.vite"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true,
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/kreemer/features/chrometesting:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  }
  // optionally set remoteUser if needed
}
